# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview
DB_USERNAME=root
DB_PASSWORD=your_database_password

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# ==================== JWT 密钥 ====================
JWT_SECRET=your_256_bit_secret_key_here

# ==================== AI 配置加密密钥 ====================
# 使用密码学安全随机源生成 32 字节并进行 Base64 编码；生产环境不得与 JWT 密钥共用。
AI_CONFIG_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# ==================== 初始管理员 ====================
# 仅当数据库中不存在有效权限管理者时使用；生产环境必须配置强密码。
RBAC_BOOTSTRAP_ADMIN_USERNAME=admin
RBAC_BOOTSTRAP_ADMIN_PASSWORD=Replace_With_Strong_Password_123!
RBAC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RBAC_BOOTSTRAP_ADMIN_NICKNAME=系统管理员

# 允许浏览器访问 API 的前端地址，多个地址用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== AI 模型 API Key ====================
DEEPSEEK_API_KEY=your_deepseek_api_key
# 当前默认使用 DeepSeek 官方端点；如需代理或兼容服务，可按部署环境修改。
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash

# ==================== DashScope 语音识别配置 ====================
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_API_ENDPOINT=https://ws-8vbrkogo9mhclh25.cn-beijing.maas.aliyuncs.com/api/v1
# 主模型；需要切换备选时在管理端选择 paraformer-v2 配置，不做自动跨模型降级。
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
# 开发测试使用 TEMPORARY_UPLOAD，无需 OSS 或公网应用地址；生产环境可改为 SIGNED_PUBLIC_URL。
DASHSCOPE_ASR_FILE_SOURCE_MODE=TEMPORARY_UPLOAD
# 仅在 SIGNED_PUBLIC_URL 模式下必填，必须是 DashScope 可从互联网访问的地址。
DASHSCOPE_ASR_PUBLIC_BASE_URL=
# 至少使用 32 位随机字符串；用于生成临时音频下载链接。
DASHSCOPE_ASR_FILE_URL_SECRET=replace_with_a_long_random_secret
DASHSCOPE_ASR_FILE_URL_TTL_SECONDS=10800
DASHSCOPE_ASR_DIARIZATION_ENABLED=true
DASHSCOPE_ASR_SPEAKER_COUNT=2
DASHSCOPE_ASR_MAX_DIARIZATION_DURATION_MINUTES=120
DASHSCOPE_ASR_POLL_INTERVAL_SECONDS=5
DASHSCOPE_ASR_TASK_TIMEOUT_SECONDS=10800
DASHSCOPE_ASR_FFMPEG_PATH=ffmpeg
# 仅 paraformer-v2 使用；未创建预编译热词表时留空。
DASHSCOPE_PARAFORMER_VOCABULARY_ID=

# ==================== 环境配置 ====================
SPRING_PROFILES_ACTIVE=dev
