# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview
DB_USERNAME=root
DB_PASSWORD=your_database_password

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# ==================== JWT 密钥 ====================
JWT_SECRET=your_256_bit_secret_key_here

# 允许浏览器访问 API 的前端地址，多个地址用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== AI 模型 API Key ====================
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
WHISPER_API_KEY=your_whisper_api_key
XIAOMI_API_KEY=your_xiaomi_api_key

# ==================== FunASR 语音识别配置 ====================
FUNASR_API_KEY=your_funasr_api_key
FUNASR_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
FUNASR_MODEL_NAME=fun-asr
# 必须是 DashScope 可从互联网访问到的应用地址，不能是 localhost。
FUNASR_PUBLIC_BASE_URL=https://api.example.com
# 至少使用 32 位随机字符串；用于生成临时音频下载链接。
FUNASR_FILE_URL_SECRET=replace_with_a_long_random_secret
FUNASR_FILE_URL_TTL_SECONDS=10800
FUNASR_DIARIZATION_ENABLED=true
# 留空时由模型自动识别；若设置，取值范围为 2-100。
FUNASR_SPEAKER_COUNT=
FUNASR_MAX_DIARIZATION_DURATION_MINUTES=120
FUNASR_POLL_INTERVAL_SECONDS=5
FUNASR_FFMPEG_PATH=ffmpeg

# ==================== 环境配置 ====================
SPRING_PROFILES_ACTIVE=dev
